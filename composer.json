{
    "name": "studioastra/astra-checkout-bundle",
    "description": "Complete, accessible and fast e-commerce for Symfony: catalog (PLP/PDP), variants, cart, checkout, customer account and orders. Twig + Tailwind CSS + Alpine.js.",
    "type": "symfony-bundle",
    "license": "MIT",
    "keywords": [
        "symfony",
        "bundle",
        "ecommerce",
        "e-commerce",
        "shop",
        "cart",
        "checkout",
        "tailwind",
        "alpinejs",
        "accessibility"
    ],
    "require": {
        "ext-intl": "*",
        "php": ">=8.2",
        "doctrine/doctrine-bundle": "^2.11|^3.0",
        "doctrine/orm": "^2.17|^3.0",
        "psr/log": "^1.1|^2.0|^3.0",
        "symfony/asset": "^6.4|^7.0|^8.0",
        "symfony/cache": "^6.4|^7.0|^8.0",
        "symfony/clock": "^6.4|^7.0|^8.0",
        "symfony/config": "^6.4|^7.0|^8.0",
        "symfony/console": "^6.4|^7.0|^8.0",
        "symfony/dependency-injection": "^6.4|^7.0|^8.0",
        "symfony/event-dispatcher": "^6.4|^7.0|^8.0",
        "symfony/form": "^6.4|^7.0|^8.0",
        "symfony/framework-bundle": "^6.4|^7.0|^8.0",
        "symfony/http-foundation": "^6.4|^7.0|^8.0",
        "symfony/http-kernel": "^6.4|^7.0|^8.0",
        "symfony/intl": "^6.4|^7.0|^8.0",
        "symfony/property-access": "^6.4|^7.0|^8.0",
        "symfony/routing": "^6.4|^7.0|^8.0",
        "symfony/security-bundle": "^6.4|^7.0|^8.0",
        "symfony/string": "^6.4|^7.0|^8.0",
        "symfony/translation": "^6.4|^7.0|^8.0",
        "symfony/twig-bundle": "^6.4|^7.0|^8.0",
        "symfony/ux-twig-component": "^2.20",
        "symfony/validator": "^6.4|^7.0|^8.0",
        "twig/twig": "^3.8"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5|^11.0",
        "symfony/browser-kit": "^6.4|^7.0|^8.0",
        "symfony/css-selector": "^6.4|^7.0|^8.0",
        "symfony/dom-crawler": "^6.4|^7.0|^8.0",
        "symfony/http-client": "^6.4|^7.0|^8.0",
        "symfony/mailer": "^6.4|^7.0|^8.0",
        "symfony/yaml": "^6.4|^7.0|^8.0"
    },
    "suggest": {
        "symfony/mailer": "Order confirmation and password reset e-mails",
        "studioastra/image-optimizer-bundle": "Lossless optimization of product images and responsive AVIF/WebP delivery (used automatically by the templates)",
        "easycorp/easyadmin-bundle": "Back-office for products, categories, customers and orders (see README)",
        "symfony/http-client": "Required by the Meilisearch search engine (typo tolerance, instant search on large catalogs)"
    },
    "autoload": {
        "psr-4": {
            "StudioAstra\\AstraCheckoutBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "StudioAstra\\AstraCheckoutBundle\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.x-dev"
        }
    }
}

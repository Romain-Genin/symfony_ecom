{% extends '@AstraCheckout/account/_auth_layout.html.twig' %}
{% trans_default_domain 'AstraCheckout' %}
{% block title %}{{ 'account.login_title'|trans }} | {{ astra.settings.shopName }}{% endblock %}
{% block heading %}{{ 'account.login_title'|trans }}{% endblock %}
{% block intro %}{% if from_checkout %}<p class="mt-3 text-center text-neutral-700">{{ 'account.login_checkout_intro'|trans }}</p>{% endif %}{% endblock %}

{% block content %}
    {% if error %}
        <div x-data="errorSummary" tabindex="-1" role="alert" class="mb-6 rounded-xl border border-red-200 bg-danger-50 p-4 text-sm text-danger-700">
            {{ error.messageKey|trans(error.messageData, 'security') }}
        </div>
    {% endif %}
    <form method="post" action="{{ path('astra_login') }}" class="space-y-5">
        <div>
            <label for="username" class="astra-label">{{ 'account.email'|trans }}</label>
            <input type="email" id="username" name="_username" value="{{ last_username }}" class="astra-input" autocomplete="email" required autofocus {% if error %}aria-invalid="true"{% endif %}>
        </div>
        <div>
            <div class="flex items-center justify-between">
                <label for="password" class="astra-label">{{ 'account.password'|trans }}</label>
                <a href="{{ path('astra_password_reset_request') }}" class="astra-link text-sm">{{ 'account.forgot_password'|trans }}</a>
            </div>
            <div class="relative" x-data="passwordToggle">
                <input type="password" id="password" name="_password" class="astra-input pr-24" autocomplete="current-password" required {% if error %}aria-invalid="true"{% endif %}>
                <button type="button" class="js-only absolute inset-y-0 right-0 mt-1 inline-flex items-center px-3 text-sm font-medium text-accent-700" @click="toggle()" :aria-pressed="visible.toString()" aria-pressed="false" aria-controls="password">
                    <span x-text="visible ? '{{ 'form.hide_password'|trans|e('js') }}' : '{{ 'form.show_password'|trans|e('js') }}'">{{ 'form.show_password'|trans }}</span>
                </button>
            </div>
        </div>
        <label class="flex min-h-11 items-center gap-3 text-sm"><input type="checkbox" name="_remember_me" class="astra-checkbox"> {{ 'account.remember_me'|trans }}</label>
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
        <button type="submit" class="astra-btn-primary astra-btn-lg w-full">{{ 'account.login_submit'|trans }}</button>
    </form>
{% endblock %}

{% block after %}
    <div class="mt-6 space-y-3 text-center text-sm text-neutral-700">
        {% if astra.settings.registrationEnabled %}<p>{{ 'account.no_account'|trans }} <a href="{{ path('astra_register') }}" class="astra-link">{{ 'account.register_link'|trans }}</a></p>{% endif %}
        {% if from_checkout and astra.settings.guestCheckoutAllowed %}<p><a href="{{ astra_path('checkout', {step: 'address'}) }}" class="astra-link">{{ 'account.continue_as_guest'|trans }}</a></p>{% endif %}
    </div>
{% endblock %}

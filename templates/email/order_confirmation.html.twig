{% extends '@AstraCheckout/email/_layout.html.twig' %}
{% trans_default_domain 'AstraCheckout' %}
{% block content %}
    <h1 style="margin:0 0 12px;font-size:22px;">{{ 'email.order_confirmation.title'|trans }}</h1>
    <p style="margin:0 0 20px;">{{ 'email.order_confirmation.intro'|trans({'%number%': order.number}) }}</p>
    {% if instructions %}
        <div style="margin:0 0 20px;padding:16px;background:#fffbeb;border:1px solid #fde68a;border-radius:8px;white-space:pre-line;">{{ instructions|trans({'{number}': order.number, '{total}': order.total|astra_price(order.currency, order.locale)}) }}</div>
    {% endif %}
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-collapse:collapse;font-size:15px;">
        {% for item in order.items %}
            <tr><td style="padding:8px 0;border-bottom:1px solid #e5e5e5;">{{ item.quantity }} × {{ item.productName }}{% if item.variantName %} – {{ item.variantName }}{% endif %}</td><td align="right" style="padding:8px 0;border-bottom:1px solid #e5e5e5;white-space:nowrap;">{{ item.total|astra_price(order.currency, order.locale) }}</td></tr>
        {% endfor %}
        {% for d in order.promotions %}
            <tr><td style="padding:8px 0;color:#15803d;">{{ d.label }}{% if d.code %} ({{ d.code }}){% endif %}</td><td align="right" style="padding:8px 0;color:#15803d;">{% if d.freeShipping %}{{ 'coupon.free_shipping'|trans }}{% else %}−{{ d.amount|astra_price(order.currency, order.locale) }}{% endif %}</td></tr>
        {% endfor %}
        <tr><td style="padding:8px 0;">{{ 'cart.shipping'|trans }} ({{ order.shippingMethodLabel }})</td><td align="right" style="padding:8px 0;">{{ order.shippingTotal|astra_price(order.currency, order.locale) }}</td></tr>
        <tr><td style="padding:8px 0;font-weight:700;">{{ 'cart.total'|trans }}</td><td align="right" style="padding:8px 0;font-weight:700;">{{ order.total|astra_price(order.currency, order.locale) }}</td></tr>
    </table>
    <p style="margin:20px 0 0;color:#525252;font-size:14px;">{{ 'checkout.shipping_address'|trans }} : {{ order.shippingAddress.lines|join(', ') }}, {{ order.shippingAddress.countryCode|astra_country(order.locale) }}</p>
{% endblock %}

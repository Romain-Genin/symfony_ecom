{% trans_default_domain 'AstraCheckout' %}
<footer class="mt-16 border-t border-neutral-200 bg-neutral-50">
    <div class="astra-container grid gap-8 py-12 sm:grid-cols-2 lg:grid-cols-4">
        <div>
            <p class="text-base font-bold">{{ astra.settings.shopName }}</p>
            <p class="mt-2 text-sm text-neutral-600">{{ 'layout.footer_tagline'|trans }}</p>
        </div>
        <nav aria-labelledby="astra-footer-shop">
            <h2 id="astra-footer-shop" class="text-sm font-semibold">{{ 'layout.footer_shop'|trans }}</h2>
            <ul role="list" class="mt-3 space-y-2 text-sm">
                <li><a class="text-neutral-700 hover:underline" href="{{ astra_path('catalog') }}">{{ 'catalog.all_products'|trans }}</a></li>
                {% for category in astra_categories()|slice(0, 4) %}
                    <li><a class="text-neutral-700 hover:underline" href="{{ astra_path('category', {slug: category.slug}) }}">{{ category.name }}</a></li>
                {% endfor %}
            </ul>
        </nav>
        <nav aria-labelledby="astra-footer-account">
            <h2 id="astra-footer-account" class="text-sm font-semibold">{{ 'layout.footer_account'|trans }}</h2>
            <ul role="list" class="mt-3 space-y-2 text-sm">
                <li><a class="text-neutral-700 hover:underline" href="{{ astra_path('account') }}">{{ 'layout.account'|trans }}</a></li>
                <li><a class="text-neutral-700 hover:underline" href="{{ astra_path('orders') }}">{{ 'account.nav.orders'|trans }}</a></li>
                <li><a class="text-neutral-700 hover:underline" href="{{ astra_path('cart') }}">{{ 'layout.cart'|trans }}</a></li>
            </ul>
        </nav>
        <div>
            <h2 class="text-sm font-semibold">{{ 'layout.footer_service'|trans }}</h2>
            <ul role="list" class="mt-3 space-y-2 text-sm text-neutral-700">
                <li>{{ 'layout.reassurance.shipping'|trans }}</li>
                <li>{{ 'layout.reassurance.returns'|trans }}</li>
                <li>{{ 'layout.reassurance.secure'|trans }}</li>
            </ul>
        </div>
    </div>
    <div class="border-t border-neutral-200">
        <p class="astra-container py-4 text-xs text-neutral-600">© {{ 'now'|date('Y') }} {{ astra.settings.shopName }}</p>
    </div>
</footer>

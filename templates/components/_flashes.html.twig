{% trans_default_domain 'AstraCheckout' %}
{% set flashes = app.request.hasPreviousSession ? app.flashes : [] %}
{% if flashes is not empty %}
    <div class="astra-container mt-4 space-y-2">
        {% for type, messages in flashes %}
            {% for message in messages %}
                {% set error = type in ['error', 'danger'] %}
                <div role="{{ error ? 'alert' : 'status' }}" class="flex items-start gap-3 rounded-xl border px-4 py-3 text-sm
                    {{ error ? 'border-red-200 bg-danger-50 text-danger-700' : (type == 'warning' ? 'border-amber-200 bg-warning-50 text-warning-800' : 'border-green-200 bg-success-50 text-success-700') }}">
                    <svg aria-hidden="true" class="mt-0.5 size-5 shrink-0" viewBox="0 0 20 20" fill="currentColor">
                        {% if error or type == 'warning' %}<path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-8-5a.75.75 0 01.75.75v4.5a.75.75 0 01-1.5 0v-4.5A.75.75 0 0110 5zm0 10a1 1 0 100-2 1 1 0 000 2z" clip-rule="evenodd"/>{% else %}<path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd"/>{% endif %}
                    </svg>
                    <p><span class="sr-only">{{ ('flash.' ~ type)|trans }} : </span>{{ message }}</p>
                </div>
            {% endfor %}
        {% endfor %}
    </div>
{% endif %}

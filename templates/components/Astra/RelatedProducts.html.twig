{% trans_default_domain 'AstraCheckout' %}
{% if products is not empty %}
    <section aria-labelledby="astra-related" {{ attributes.defaults({class: 'mt-16 border-t border-neutral-200 pt-12'}) }}>
        <h2 id="astra-related" class="text-2xl font-bold tracking-tight">{% block title %}{{ 'product.related'|trans }}{% endblock %}</h2>
        <ul role="list" class="mt-6 grid grid-cols-2 gap-x-4 gap-y-8 sm:grid-cols-4 sm:gap-x-6">
            {% for p in products %}<li><twig:Astra:ProductCard :product="p" /></li>{% endfor %}
        </ul>
    </section>
{% endif %}

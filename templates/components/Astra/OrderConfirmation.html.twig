{% trans_default_domain 'AstraCheckout' %}
{# <twig:Astra:OrderConfirmation /> on your confirmation page (route parameter {token}). #}
{% if order is null %}
    <p role="alert" {{ attributes }}>{{ 'order.not_found'|trans }}</p>
{% else %}
<div {{ attributes }}>
    <div class="text-center">
        <span class="mx-auto inline-flex size-14 items-center justify-center rounded-full bg-success-50 text-success-700" aria-hidden="true">
            <svg class="size-8" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m5 13 4 4L19 7"/></svg>
        </span>
        <h1 class="mt-4 text-3xl font-bold tracking-tight">{{ 'checkout.confirmation.title'|trans }}</h1>
        <p class="mt-3 text-neutral-700">{{ 'checkout.confirmation.number'|trans({'%number%': order.number})|raw }}</p>
        <p class="mt-1 text-neutral-700">{{ 'checkout.confirmation.email'|trans({'%email%': order.email}) }}</p>
    </div>

    {% if instructions %}
        <section aria-labelledby="astra-instructions" class="mt-8 rounded-2xl border border-amber-200 bg-warning-50 p-5">
            <h2 id="astra-instructions" class="font-semibold text-warning-800">{{ 'checkout.confirmation.next_step'|trans }}</h2>
            <p class="mt-2 whitespace-pre-line text-sm text-neutral-800">{{ instructions|trans({'{number}': order.number, '{total}': order.total|astra_price(order.currency)}) }}</p>
        </section>
    {% endif %}

    {{ include('@AstraCheckout/components/_order_details.html.twig') }}

    <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
        <a href="{{ astra_path('catalog') }}" class="astra-btn-primary">{{ 'cart.continue'|trans }}</a>
        {% if order.customer is null and astra.settings.registerRoute %}
            <a href="{{ path(astra.settings.registerRoute) }}" class="astra-btn-secondary">{{ 'checkout.confirmation.create_account'|trans }}</a>
        {% elseif order.customer %}
            <a href="{{ astra_path('order', {number: order.number}) }}" class="astra-btn-secondary">{{ 'checkout.confirmation.track'|trans }}</a>
        {% endif %}
    </div>
</div>
{% endif %}

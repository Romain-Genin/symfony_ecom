{% trans_default_domain 'AstraCheckout' %}
{# <twig:Astra:ProductGallery :product="product" class="lg:sticky lg:top-24" /> #}
{% set images = product.images %}
<section aria-label="{{ 'product.gallery'|trans }}" x-data="gallery({{ max(1, images|length) }})" {{ attributes }}>
    <div class="relative aspect-[4/5] overflow-hidden rounded-2xl bg-neutral-100">
        {% for image in images %}
            <div {% if not loop.first %}x-cloak hidden{% endif %} :hidden="current !== {{ loop.index0 }}" class="h-full w-full">
                {{ astra_image(image.path, {
                    alt: image.altText,
                    width: image.width, height: image.height,
                    sizes: sizes,
                    class: 'h-full w-full object-cover',
                    loading: loop.first ? 'eager' : 'lazy',
                    fetchpriority: loop.first ? 'high' : null,
                }) }}
            </div>
        {% else %}
            {{ astra_image(null, {alt: product.name, class: 'h-full w-full'}) }}
        {% endfor %}
    </div>
    {% if images|length > 1 %}
        <div role="group" aria-label="{{ 'product.thumbnails'|trans }}" class="js-only mt-4 flex gap-3 overflow-x-auto pb-1" @keydown="key($event)">
            {% for image in images %}
                <button type="button" data-thumb class="relative size-20 shrink-0 overflow-hidden rounded-lg bg-neutral-100 ring-offset-2"
                        :class="current === {{ loop.index0 }} ? 'ring-2 ring-neutral-900' : 'ring-1 ring-neutral-300 hover:ring-neutral-500'"
                        :aria-current="current === {{ loop.index0 }} ? 'true' : 'false'" :tabindex="current === {{ loop.index0 }} ? 0 : -1"
                        @click="show({{ loop.index0 }})">
                    {{ astra_image(image.path, {alt: '', width: 80, height: 100, sizes: '80px', class: 'h-full w-full object-cover'}) }}
                    <span class="sr-only">{{ 'product.show_image'|trans({'%index%': loop.index, '%count%': images|length}) }}</span>
                </button>
            {% endfor %}
        </div>
    {% endif %}
</section>

{% trans_default_domain 'AstraCheckout' %}
{# items: list of {label, url}; the last one is the current page. Also emits BreadcrumbList JSON-LD. #}
<nav {{ attributes.defaults({'aria-label': 'layout.breadcrumb'|trans, class: 'text-sm'}) }}>
    <ol role="list" class="flex flex-wrap items-center gap-1.5 text-neutral-600">
        {% for item in items %}
            <li class="flex items-center gap-1.5">
                {% if not loop.first %}<svg aria-hidden="true" class="size-4 text-neutral-400" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 01.02-1.06L11.17 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z" clip-rule="evenodd"/></svg>{% endif %}
                {% if loop.last %}
                    <span aria-current="page" class="font-medium text-neutral-900">{{ item.label }}</span>
                {% else %}
                    <a href="{{ item.url }}" class="hover:text-neutral-900 hover:underline">{{ item.label }}</a>
                {% endif %}
            </li>
        {% endfor %}
    </ol>
</nav>
{{ astra_json_ld({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: items|map((item, i) => {'@type': 'ListItem', position: i + 1, name: item.label, item: item.url ? absolute_url(item.url) : null}|filter(v => v is not null)),
}) }}

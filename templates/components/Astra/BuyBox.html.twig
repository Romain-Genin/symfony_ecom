{% trans_default_domain 'AstraCheckout' %}
{# <twig:Astra:BuyBox :product="product" /> — price, offers, variant picker, stock, add to cart. #}
{% set matrix = product.optionMatrix %}
{% set low_threshold = astra.settings.lowStockThreshold %}
{% set v = selectedVariant %}
<div {{ attributes }} x-data="variantPicker({{ variants|json_encode(constant('JSON_HEX_TAG') b-or constant('JSON_HEX_APOS') b-or constant('JSON_HEX_QUOT') b-or constant('JSON_HEX_AMP') b-or constant('JSON_UNESCAPED_UNICODE'))|e('html_attr') }}, {{ selectedVariant ? selectedVariant.id : 'null' }})">
    {% if product.brand %}<p class="text-sm font-medium uppercase tracking-wide text-neutral-600">{{ product.brand }}</p>{% endif %}
    <h{{ headingLevel }} class="mt-1 text-3xl font-bold tracking-tight text-neutral-900 sm:text-4xl">{{ product.name }}</h{{ headingLevel }}>

    <div class="mt-4" aria-live="off">
        <div class="no-js-only">
            <twig:Astra:ProductPrice :price="product.minPrice" :compareAt="product.compareAtPrice" :from="product.hasPriceRange" size="lg" />
        </div>
        <p class="js-only flex flex-wrap items-baseline gap-x-2 text-2xl" x-show="variant">
            <template x-if="variant && variant.compareAt">
                <span class="contents">
                    <ins class="font-semibold text-danger-700"><span class="sr-only">{{ 'price.sale'|trans }} </span><span x-text="variant.price"></span></ins>
                    <del class="text-lg text-neutral-600"><span class="sr-only">{{ 'price.regular'|trans }} </span><span x-text="variant.compareAt"></span></del>
                </span>
            </template>
            <template x-if="variant && !variant.compareAt">
                <span class="font-semibold"><span class="sr-only">{{ 'price.label'|trans }} </span><span x-text="variant.price"></span></span>
            </template>
        </p>
        <p class="mt-1 text-sm text-neutral-600">{{ (astra.settings.pricesIncludeTax ? 'price.tax_included' : 'price.tax_excluded')|trans }}</p>
    </div>

    {% if promotions is not empty %}
        <ul role="list" aria-label="{{ 'product.offers'|trans }}" class="mt-4 space-y-2">
            {% for promotion in promotions %}
                <li class="flex items-start gap-2 rounded-lg bg-accent-50 px-3 py-2 text-sm font-medium text-accent-900">
                    <svg aria-hidden="true" class="mt-0.5 size-4 shrink-0" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M5.5 3A2.5 2.5 0 003 5.5v2.879a2.5 2.5 0 00.732 1.767l6.5 6.5a2.5 2.5 0 003.536 0l2.878-2.878a2.5 2.5 0 000-3.536l-6.5-6.5A2.5 2.5 0 008.38 3H5.5zM6 7a1 1 0 100-2 1 1 0 000 2z" clip-rule="evenodd"/></svg>
                    <span>{{ promotion.displayLabel }}{% if promotion.minSubtotal %} <span class="font-normal">({{ 'promotion.from_amount'|trans({'%amount%': promotion.minSubtotal|astra_price}) }})</span>{% endif %}</span>
                </li>
            {% endfor %}
        </ul>
    {% endif %}

    {% if product.shortDescription %}<p class="mt-6 text-neutral-700">{{ product.shortDescription }}</p>{% endif %}

    <form action="{{ path('astra_cart_add') }}" method="post" class="mt-8 space-y-6" x-data="addToCart" @submit.prevent="submit($event)">
        {% if matrix is not empty %}
            {# With JavaScript: one radio group per option. #}
            {% for name, values in matrix %}
                {% set group = loop.index %}
                <fieldset class="js-only">
                    <legend class="text-sm font-medium text-neutral-900">{{ name }} : <span class="font-normal text-neutral-700" x-text="selected[{{ name|json_encode|e('html_attr') }}]"></span></legend>
                    <div class="mt-3 flex flex-wrap gap-2">
                        {% for value in values %}
                            <label class="relative">
                                <input type="radio" class="peer sr-only" name="option_{{ group }}" value="{{ value }}"
                                       :checked="selected[{{ name|json_encode|e('html_attr') }}] === {{ value|json_encode|e('html_attr') }}"
                                       @change="choose({{ name|json_encode|e('html_attr') }}, {{ value|json_encode|e('html_attr') }})">
                                <span class="astra-pill" :class="!isPossible({{ name|json_encode|e('html_attr') }}, {{ value|json_encode|e('html_attr') }}) && 'astra-pill-unavailable'">
                                    {{ value }}<span class="sr-only" x-show="!isPossible({{ name|json_encode|e('html_attr') }}, {{ value|json_encode|e('html_attr') }})"> ({{ 'product.out_of_stock'|trans }})</span>
                                </span>
                            </label>
                        {% endfor %}
                    </div>
                </fieldset>
            {% endfor %}
            <input type="hidden" name="variant" :value="variant ? variant.id : ''" disabled :disabled="false" class="js-only">

            {# Without JavaScript: a plain select of every variant. #}
            <div class="no-js-only">
                <label for="astra-variant" class="astra-label">{{ 'product.choose_variant'|trans }}</label>
                <select id="astra-variant" name="variant" class="astra-select" x-bind:disabled="true">
                    {% for variant in product.variants %}
                        <option value="{{ variant.id }}" {{ variant == selectedVariant ? 'selected' }} {{ not variant.available ? 'disabled' }}>
                            {{ variant.label }} – {{ variant.price|astra_price }}{% if not variant.available %} ({{ 'product.out_of_stock'|trans }}){% endif %}
                        </option>
                    {% endfor %}
                </select>
            </div>
        {% else %}
            <input type="hidden" name="variant" value="{{ selectedVariant ? selectedVariant.id }}">
        {% endif %}

        {# Stock status: text + icon, never colour alone. #}
        {% set v = selectedVariant %}
        <p class="flex items-center gap-2 text-sm font-medium" :class="available ? (variant && variant.low ? 'text-warning-800' : 'text-success-700') : 'text-neutral-700'">
            <svg aria-hidden="true" class="size-5" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd"/></svg>
            <span x-text="stockLabel">{% if v and v.available %}{{ v.lowStock(low_threshold) ? 'product.low_stock'|trans({'%count%': v.stock}) : 'product.in_stock'|trans }}{% else %}{{ 'product.out_of_stock'|trans }}{% endif %}</span>
        </p>

        <div class="flex flex-wrap items-end gap-3">
            <div x-data="quantity(1, {{ min(astra.settings.maxQuantityPerItem, v and v.stock is not null ? max(1, v.stock) : astra.settings.maxQuantityPerItem) }})" class="w-36">
                <label for="astra-quantity" class="astra-label">{{ 'cart.quantity'|trans }}</label>
                <div class="mt-1 flex items-stretch rounded-lg border border-neutral-500">
                    <button type="button" class="js-only inline-flex w-11 items-center justify-center text-lg" @click="dec()" :disabled="value <= min" aria-controls="astra-quantity"><span aria-hidden="true">−</span><span class="sr-only">{{ 'cart.decrease'|trans }}</span></button>
                    <input id="astra-quantity" x-ref="input" type="number" name="quantity" value="1" min="1" max="{{ astra.settings.maxQuantityPerItem }}" inputmode="numeric"
                           class="min-h-11 w-full min-w-0 border-0 bg-transparent text-center text-base [appearance:textfield] [&::-webkit-inner-spin-button]:appearance-none" @change="set($event.target.value)">
                    <button type="button" class="js-only inline-flex w-11 items-center justify-center text-lg" @click="inc()" :disabled="value >= max" aria-controls="astra-quantity"><span aria-hidden="true">+</span><span class="sr-only">{{ 'cart.increase'|trans }}</span></button>
                </div>
            </div>
            <button type="submit" class="astra-btn-primary astra-btn-lg flex-1" {{ not (v and v.available) ? 'disabled' }} :disabled="!available || busy" :aria-busy="busy.toString()">
                <svg x-show="busy" x-cloak aria-hidden="true" class="size-5 animate-spin" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-opacity=".3" stroke-width="3"/><path d="M21 12a9 9 0 0 0-9-9" stroke="currentColor" stroke-width="3" stroke-linecap="round"/></svg>
                <span x-text="available ? '{{ 'product.add_to_cart'|trans|e('js') }}' : '{{ 'product.out_of_stock'|trans|e('js') }}'">{{ (v and v.available ? 'product.add_to_cart' : 'product.out_of_stock')|trans }}</span>
            </button>
        </div>
        <p x-show="error" x-cloak x-text="error" role="alert" class="astra-field-error"></p>
    </form>

    {% if reassurance %}
    <ul role="list" class="mt-8 grid gap-3 rounded-2xl bg-neutral-50 p-5 text-sm text-neutral-800 sm:grid-cols-3 lg:grid-cols-1 xl:grid-cols-3">
        <li class="flex items-center gap-2"><svg aria-hidden="true" class="size-5 text-neutral-600" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M3 7h11v9H3zM14 10h4l3 3v3h-7"/><circle cx="7" cy="17" r="1.5"/><circle cx="17" cy="17" r="1.5"/></svg>{{ 'layout.reassurance.shipping'|trans }}</li>
        <li class="flex items-center gap-2"><svg aria-hidden="true" class="size-5 text-neutral-600" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M4 12a8 8 0 1 0 3-6.2M4 4v4h4"/></svg>{{ 'layout.reassurance.returns'|trans }}</li>
        <li class="flex items-center gap-2"><svg aria-hidden="true" class="size-5 text-neutral-600" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor"><rect x="5" y="11" width="14" height="9" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></svg>{{ 'layout.reassurance.secure'|trans }}</li>
    </ul>
    {% endif %}
    <dl class="mt-6 grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-sm text-neutral-700">
        <dt class="font-medium">{{ 'product.sku'|trans }}</dt>
        <dd><span x-text="variant ? variant.sku : '{{ (v ? v.sku : '')|e('js') }}'">{{ v ? v.sku }}</span></dd>
    </dl>
</div>

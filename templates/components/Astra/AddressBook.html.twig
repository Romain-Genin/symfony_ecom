{% trans_default_domain 'AstraCheckout' %}
{# <twig:Astra:AddressBook /> — address book of the logged-in customer. #}
<div {{ attributes }}>
    {% if addButton %}<a href="{{ astra_path('address_new') }}" class="astra-btn-primary">{{ 'address.add'|trans }}</a>{% endif %}
    {% if addresses is empty %}
        <p class="mt-6 text-neutral-700">{{ 'address.none'|trans }}</p>
    {% else %}
        <ul role="list" class="mt-6 grid gap-4 sm:grid-cols-2">
            {% for address in addresses %}
                {% set title = address.label ?: address.postalAddress.fullName %}
                <li class="astra-card flex flex-col p-5">
                    <div class="flex items-start justify-between gap-3">
                        <h{{ headingLevel }} class="font-semibold">{{ title }}</h{{ headingLevel }}>
                        {% if address.default %}<span class="astra-badge bg-neutral-900 text-white">{{ 'address.default_badge'|trans }}</span>{% endif %}
                    </div>
                    <address class="mt-2 flex-1 not-italic text-sm text-neutral-700">{% for line in address.postalAddress.lines %}{{ line }}<br>{% endfor %}{{ address.postalAddress.countryCode|astra_country(app.request.locale) }}{% if address.postalAddress.phone %}<br>{{ address.postalAddress.phone }}{% endif %}</address>
                    <div class="mt-4 flex flex-wrap gap-x-4 gap-y-2 text-sm">
                        <a href="{{ astra_path('address_edit', {id: address.id}) }}" class="astra-link">{{ 'address.edit'|trans }}<span class="sr-only"> {{ title }}</span></a>
                        {% if not address.default %}
                            <form method="post" action="{{ path('astra_account_address_default', {id: address.id}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('default-address-' ~ address.id) }}">
                                <button class="astra-link">{{ 'address.make_default'|trans }}<span class="sr-only"> : {{ title }}</span></button>
                            </form>
                        {% endif %}
                        <form method="post" action="{{ path('astra_account_address_delete', {id: address.id}) }}" x-data @submit="confirm('{{ 'address.delete_confirm'|trans|e('js') }}') || $event.preventDefault()">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete-address-' ~ address.id) }}">
                            <button class="font-medium text-danger-700 underline">{{ 'address.delete'|trans }}<span class="sr-only"> {{ title }}</span></button>
                        </form>
                    </div>
                </li>
            {% endfor %}
        </ul>
    {% endif %}
</div>

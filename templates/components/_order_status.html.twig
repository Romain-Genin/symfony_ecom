{% trans_default_domain 'AstraCheckout' %}
{% set colors = {
    pending_payment: 'bg-amber-100 text-amber-900',
    paid: 'bg-blue-100 text-blue-900',
    processing: 'bg-blue-100 text-blue-900',
    shipped: 'bg-indigo-100 text-indigo-900',
    delivered: 'bg-green-100 text-green-900',
    cancelled: 'bg-neutral-200 text-neutral-800',
    refunded: 'bg-neutral-200 text-neutral-800',
} %}
<span class="astra-badge {{ colors[status.value] }}"><span class="sr-only">{{ 'order.status_label'|trans }} </span>{{ status.translationKey|trans }}</span>
